{
  "name": "sb-task-tracker",
  "version": "2.0.0",
  "private": true,
  "description": "Task Tracker: private team task, KPI and summary workspace with approved Google sign-in",
  "type": "module",
  "scripts": {
    "dev": "tsx scripts/dev-server.ts",
    "build": "vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "db:migrate": "tsx scripts/migrate.ts",
    "provision-admin": "tsx scripts/provision-admin.ts",
    "check:public": "tsx scripts/check-public-build.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "exceljs": "4.4.0",
    "jose": "6.2.15",
    "pg": "8.23.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@netlify/functions": "6.0.3",
    "@types/node": "26.6.6",
    "@types/pg": "8.23.1",
    "playwright": "1.64.1",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.1.0"
  },
  "overrides": {
    "uuid": "11.1.1"
  }
}
