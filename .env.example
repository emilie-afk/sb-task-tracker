# DO NOT put real passwords here.
# Set these in: Netlify Dashboard → Site → Environment variables

PASSWORD_EMILIE=your_manager_password
PASSWORD_THAO=thao_password
PASSWORD_TUNG=tung_password

# Brand access is already set by default in auth.js:
#   Thao → sb, hian, expat
#   Tung  → sb
# Only add these if you want to change the defaults:
# BRANDS_THAO=sb,hian,expat,snack
# BRANDS_TUNG=sb,hian
