# Names only. Set real values privately (Netlify environment variables, Functions scope). Never commit values.
# PostgreSQL connection for this app's OWN database (or isolated schema) with a restricted role. Never the dashboard's.
DATABASE_URL=
# Exact public origin of this app, e.g. https://<site>.netlify.app (no path). The OAuth callback is APP_BASE_URL/api/auth/callback.
APP_BASE_URL=
# Random server secret, at least 32 characters (CSRF tokens, sign-in browser binding, rate-limit key hashing).
APP_SECRET=
# Google OAuth web client for this app (authorized redirect URI must be exactly APP_BASE_URL/api/auth/callback).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Stable identifier of this tracker instance, reported to the marketing dashboard (e.g. tracker-prod).
TRACKER_INSTANCE_ID=
# Dashboard business ids an administrator may map brands to (validation only; mapping itself is stored privately).
DASHBOARD_BUSINESS_IDS=
# Local only
TEST_DATABASE_URL=
PRIVATE_TERMS_FILE=
